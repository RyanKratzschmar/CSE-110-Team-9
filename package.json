{
  "name": "mathgame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn-based dungeon math RPG for 5th graders",
  "scripts": {
    "dev:backend": "tsx watch backend/server.ts",
    "dev:frontend": "vite",
    "build": "vite build",
    "start": "tsx backend/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.21.2",
    "konva": "^10.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "jsdom": "^30.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  }
}
